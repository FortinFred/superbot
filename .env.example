# Copy to .env and fill in. Run: set -a; . ./.env; set +a; ./target/release/botd

# Required when HOST is not 127.0.0.1. Browser login: any username, this password.
AUTH_PASSWORD=
HOST=127.0.0.1
PORT=3000

# Your name, shown in the app and told to the Bots.
USER_NAME=

# Which ACP agent new Bots start on: copilot or opencode (or an ACP_AGENTS id).
DEFAULT_AGENT=copilot

# Extra ACP agents, as id:Name:command, comma-separated. Bridges such as
# pi-acp or claude-agent-acp are configured here, not built in.
# e.g. pi:Pi:npx pi-acp@0.0.34
ACP_AGENTS=

# Where the database, Bot memory, and agent sessions live. Back this up.
DATA_DIR=./data
# The Bots' shared working folder (their "computer").
WORKSPACE_DIR=./workspace

# Server time zone. Routines run on it.
TZ=UTC

# Max minutes for one task before it is stopped.
RUN_TIMEOUT_MINUTES=60

# Name of the primary Bot created on first start.
PRIMARY_BOT_NAME=Assistant

# Models for the picker. ACP has no model listing, so declare them here:
# comma-separated ids per agent. Agents also read <AGENT>_MODEL as their default.
# e.g. claude-sonnet-4.5,gpt-5.1
COPILOT_MODELS=
# OPENCODE_MODELS=

# Copilot CLI BYOK: point the CLI at another OpenAI-compatible provider.
# COPILOT_PROVIDER_BASE_URL=
# COPILOT_PROVIDER_API_KEY=
# COPILOT_MODEL=
# Per-Bot CLI state (skills, plugins, sessions) instead of the shared ~/.copilot.
# COPILOT_HOME=

# Bot screens (docs/computer.md). On when Xvfb and openbox are installed.
SCREENS=on
MAX_SCREENS=3
SCREEN_IDLE_MINUTES=10
SCREEN_SIZE=1280x800
# Displays are :SCREEN_BASE+n, voxl ports 6800+SCREEN_BASE+n. Change it to run two servers on one machine.
SCREEN_BASE=100
AGENT_BROWSER_SKILLS_DIR=/opt/computer/share/agent-browser-skills
